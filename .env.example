# Hyrule Warriors (Wii U) - NEX server config.
# Copy to .env and fill in. All names are namespaced PN_HYRULEWARRIORS_*.

# --- PRUDP listeners ---
PN_HYRULEWARRIORS_AUTH_PORT=26000
PN_HYRULEWARRIORS_SECURE_PORT=26001
# Host the client is told to reach the secure server on. MUST be short: the
# retail binary truncates it into a ~15-char buffer.
PN_HYRULEWARRIORS_SECURE_HOST=localhost

# --- Database (ranking + DataStore + matchmaking, one database) ---
PN_HYRULEWARRIORS_POSTGRES_URI=postgres://hyrulewarriors:hyrulewarriors@localhost:5432/hyrulewarriors?sslmode=disable

# --- Kerberos / system accounts ---
PN_HYRULEWARRIORS_KERBEROS_PASSWORD=change-me

# --- Auth mode ----------------------------------------------------------
# 1 = isolated preservation mode: accounts from settings.json, login token
#     not validated. Leave the two NEX_* vars below empty.
PN_HYRULEWARRIORS_LOCAL_MODE=1
PN_HYRULEWARRIORS_SETTINGS_PATH=settings.json

# Required only when PN_HYRULEWARRIORS_LOCAL_MODE is not 1:
PN_HYRULEWARRIORS_NEX_TOKEN_AES_KEY=
PN_HYRULEWARRIORS_NEX_PASSWORD_SECRET=

# --- Optional: DataStore object uploads (Network Link / My Fairy) -----
# Only needed if players PUBLISH objects. Downloading works without S3.
PN_S3_ENDPOINT=
PN_S3_ACCESS_KEY=
PN_S3_SECRET_KEY=
PN_S3_BUCKET=hyrulewarriors-datastore
